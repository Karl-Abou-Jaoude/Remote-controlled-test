---
interface Props {
  id: string;
  /** Mono section number, e.g. '02'. Functional, not decorative. */
  index?: string;
  /** Short mono label above the heading. */
  eyebrow?: string;
  /** Inverts to the near-black band. Used sparingly — twice on the page. */
  tone?: 'paper' | 'ink';
  class?: string;
}

const { id, index, eyebrow, tone = 'paper', class: className = '' } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    'relative',
    tone === 'ink' ? 'on-ink bg-ink text-text-inverse' : 'bg-paper text-text',
    className,
  ]}
>
  <div class="container-page py-20 md:py-28 lg:py-36">
    {
      (index || eyebrow) && (
        <div
          class:list={[
            'label mb-8 flex items-baseline gap-4',
            tone === 'ink' ? 'text-text-dim' : 'text-text-muted',
          ]}
        >
          {index && <span class={tone === 'ink' ? 'text-accent-hot' : 'text-accent'}>{index}</span>}
          {eyebrow && <span>{eyebrow}</span>}
          <span
            class:list={[
              'ml-2 h-px flex-1 translate-y-[-0.15em]',
              tone === 'ink' ? 'bg-line-ink' : 'bg-line',
            ]}
            aria-hidden="true"
          ></span>
        </div>
      )
    }
    <slot name="heading" />
    <slot />
  </div>
</section>
