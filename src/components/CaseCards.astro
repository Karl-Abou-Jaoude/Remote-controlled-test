---
import { cases } from '../data/work';
import { isPlaceholder } from '../lib/placeholder';
import SectionHead from './SectionHead.astro';
import Diff from './Diff.astro';

/**
 * Three cards, deliberately asymmetric — the page's one intentional grid break,
 * so the eye registers a composition rather than another equal row.
 *
 * Every card carries a live production URL. Two independent Shopify buyer guides
 * say near-verbatim: ask for live URLs of stores they built. A screenshot is not
 * proof, and everything the hover state reveals is equally revealed by
 * :focus-visible, so the keyboard path is not second class.
 */
---

<section id="cases" aria-labelledby="cases-heading" class="py-20 md:py-30">
  <div class="container-page">
    <SectionHead index="06" id="cases-heading">Three builds, in detail</SectionHead>

    <p class="text-body-lead mt-6 max-w-[54ch] text-muted">
      Each one names the constraint I worked inside, the decisions I made and why, and where the
      numbers came from. The stores are live — open them.
    </p>

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      {
        cases.map((c, i) => (
          <article
            class:list={[
              'group flex flex-col gap-6 border border-hairline bg-surface-card p-6 transition-colors duration-[var(--duration-base)] hover:border-hairline-ui focus-within:border-hairline-ui',
              i === 0 ? 'lg:col-span-12' : 'lg:col-span-6',
            ]}
          >
            <div class:list={[i === 0 && 'lg:grid lg:grid-cols-12 lg:gap-10']}>
              <div class={i === 0 ? 'lg:col-span-7' : ''}>
                <h3 class:list={['display uppercase', i === 0 ? 'text-display-md' : 'text-display-sm']}>
                  <a href={`/work/${c.slug}/`} class="no-underline hover:underline">
                    {c.headline}
                  </a>
                </h3>

                <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-hairline pt-5">
                  <div>
                    <dt class="label text-muted">Brand</dt>
                    <dd class="text-body-sm mt-1">
                      {c.brand} · {c.vertical}
                    </dd>
                  </div>
                  <div>
                    <dt class="label text-muted">Markets & GMV</dt>
                    <dd class="text-body-sm mt-1 [font-variant-numeric:tabular-nums]">
                      {c.region} · {c.gmvBand}
                    </dd>
                  </div>
                  <div>
                    <dt class="label text-muted">Duration</dt>
                    <dd class="text-body-sm mt-1">{c.duration}</dd>
                  </div>
                  <div>
                    <dt class="label text-muted">What’s mine on this page</dt>
                    <dd class="text-body-sm mt-1">{c.role}</dd>
                  </div>
                </dl>
              </div>

              <div class:list={[i === 0 ? 'lg:col-span-5 lg:pt-2' : 'mt-6']}>
                <Diff minus={c.diff.minus} plus={c.diff.plus} />
              </div>
            </div>

            <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-hairline pt-5">
              <a href={`/work/${c.slug}/`} class="label text-on-dark no-underline">
                Read the case →
              </a>
              {!isPlaceholder(c.liveUrl) ? (
                <a
                  href={c.liveUrl}
                  rel="noopener"
                  class="label flex min-h-12 items-center text-muted"
                  data-position={`case-live-${c.slug}`}
                >
                  Open the live store →
                </a>
              ) : (
                <span class="label text-muted">Live store URL pending — see CONTENT.md</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
