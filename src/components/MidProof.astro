---
import { hero, testimonials } from '../data/site';
import Cta from './Cta.astro';
import Testimonial from './Testimonial.astro';

const commercial = testimonials.find((t) => t.id === 'commercial');
---

<!--
  Mid-page CTA for the buyer already convinced at the halfway mark — with the
  proof stacked directly underneath rather than in a separate distant section.
  Moving the testimonial and proof to sit immediately under the CTA (rather than
  in its own band) is one of the better-documented single-change lifts on a
  services page.

  Same words as every other primary CTA. Role-matched: the commercial quote sits
  next to the commercial tiles.
-->
<section id="proof" aria-labelledby="proof-heading" class="border-y border-line bg-paper-sunk py-20 md:py-24">
  <div class="container-page">
    <h2 id="proof-heading" class="sr-only">Book a call</h2>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6">
        <p class="display text-display max-w-[24ch]">
          Twenty minutes is usually enough to tell you what I’d do first.
        </p>
        <div class="mt-8">
          <Cta
            kind="book"
            position="mid-page"
            variant="primary"
            note={hero.doubtRemover}
            reversal={hero.reversal}
          >
            {hero.primaryCta}
          </Cta>
        </div>
      </div>

      <div class="lg:col-span-6 lg:pl-10">
        {commercial && <Testimonial {...commercial} />}
      </div>
    </div>
  </div>
</section>
