---
import { triage } from '../data/site';
import SectionHead from './SectionHead.astro';
import Diff from './Diff.astro';

/**
 * Four named jobs-to-be-done, not a technology list, so the buyer self-selects
 * into a problem they already know they have and the enquiry arrives
 * pre-qualified. Urgent first.
 *
 * Unequal tiles communicate range faster than a bulleted list. Nothing is
 * collapsed behind an accordion — hiding the offer costs more than the scroll.
 * The prose inside never animates: this is the content a buyer is reading to
 * decide, and scroll-revealing body text makes people wait for it.
 */
---

<section id="triage" aria-labelledby="triage-heading" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHead index="04" id="triage-heading">What I get hired for</SectionHead>

    <div class="mt-16 grid gap-6 lg:grid-cols-12">
      {
        triage.map((job, i) => (
          <article
            class:list={[
              'flex flex-col gap-6 border border-line bg-paper-raised p-6 transition-colors duration-[var(--duration-base)] hover:border-line-strong',
              i === 0 ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5',
            ]}
          >
            <div>
              <h3 class="display text-title">
                {job.title}
              </h3>
              <p class:list={['mt-3 text-text-muted', i === 0 ? 'text-lead max-w-[48ch]' : 'text-body']}>
                {job.prose}
              </p>
            </div>

            <Diff minus={job.diff.minus} plus={job.diff.plus} class="mt-auto" />

            <ul class="flex flex-wrap gap-2" aria-label="Relevant surfaces">
              {job.chips.map((chip) => (
                <li class="label border border-line px-3 py-1.5 text-text-muted">
                  {chip}
                </li>
              ))}
            </ul>

            <a href={`/work/${job.caseSlug}/`} class="label w-fit text-accent">
              See this shipped →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
