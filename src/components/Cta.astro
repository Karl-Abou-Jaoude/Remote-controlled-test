---
import { contact } from '../data/site';

/**
 * Every CTA on the page is this component, so the primary ask is worded
 * identically everywhere (3–5 instances of the SAME cta, never a competing
 * second offer) and every click reports the position that produced it — the one
 * analytics number worth having is which placement produces bookings.
 *
 * The booking variant is a real anchor to the hosted booking page: it works with
 * JavaScript off and before the embed is warm. The inline embed is an upgrade,
 * never a requirement.
 */
interface Props {
  kind?: 'book' | 'link';
  href?: string;
  position: string;
  /**
   * `primary` is the transparent outlined pill — the signature CTA. `quiet` is
   * the same mono voice with no pill, for a second action that must not compete
   * with the primary one. There is no filled variant: a solid button reads as
   * off-brand in this system.
   */
  variant?: 'primary' | 'quiet';
  size?: 'default' | 'compact';
  /** Tone microcopy under the button. */
  note?: string;
  /** Actual risk reversal — kept distinct from `note`, which is tone. */
  reversal?: string;
  full?: boolean;
  class?: string;
}

const {
  kind = 'book',
  href,
  position,
  variant = 'primary',
  size = 'default',
  note,
  reversal,
  full = false,
  class: className = '',
} = Astro.props;

const target = kind === 'book' ? contact.calUrl : (href ?? '#');
const bookAttrs =
  kind === 'book' ? { 'data-cal-link': contact.calLink, 'data-cal-trigger': 'true' } : {};
---

<span class:list={['flex flex-col gap-2.5', full ? 'w-full' : 'items-start', className]}>
  <a
    href={target}
    data-position={position}
    class:list={[
      'btn group',
      // `.btn` alone IS the primary treatment, so only the quiet variant needs a
      // modifier — emitting `btn--primary` would be a class with no rule behind it.
      variant !== 'primary' && `btn--${variant}`,
      size === 'compact' && 'min-h-10 px-5 py-2',
      full && 'w-full',
    ]}
    {...bookAttrs}
  >
    <slot />
    <span
      aria-hidden="true"
      class="inline-block transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-quint)] group-hover:translate-x-1"
      >→</span
    >
  </a>

  {note && <span class="text-body-sm max-w-[42ch] text-muted">{note}</span>}

  {
    reversal && (
      <span class="text-body-sm flex max-w-[42ch] items-start gap-2 text-muted">
        <span aria-hidden="true" class="text-on-dark">
          ✓
        </span>
        {reversal}
      </span>
    )
  }
</span>
