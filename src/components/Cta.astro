---
import { contact } from '../data/site';

/**
 * Every CTA on the page is this component, so the primary ask is worded
 * identically everywhere (3–5 instances of the SAME cta, never a competing
 * second offer) and every click reports the position that produced it — the one
 * analytics number worth having is which placement produces bookings.
 *
 * The booking variant is a real anchor to the hosted booking page: it works with
 * JavaScript off and before the embed is warm. The inline embed is an upgrade,
 * never a requirement.
 */
interface Props {
  kind?: 'book' | 'link';
  href?: string;
  position: string;
  variant?: 'primary' | 'secondary' | 'inverse';
  size?: 'default' | 'compact';
  /** Tone microcopy under the button. */
  note?: string;
  /** Actual risk reversal — kept distinct from `note`, which is tone. */
  reversal?: string;
  full?: boolean;
  class?: string;
}

const {
  kind = 'book',
  href,
  position,
  variant = 'primary',
  size = 'default',
  note,
  reversal,
  full = false,
  class: className = '',
} = Astro.props;

const target = kind === 'book' ? contact.calUrl : (href ?? '#');
const bookAttrs =
  kind === 'book' ? { 'data-cal-link': contact.calLink, 'data-cal-trigger': 'true' } : {};
---

<span class:list={['flex flex-col gap-2.5', full ? 'w-full' : 'items-start', className]}>
  <a
    href={target}
    data-position={position}
    class:list={[
      'btn group',
      `btn--${variant}`,
      size === 'compact' && 'min-h-10 px-5 py-2 text-[0.875rem]',
      full && 'w-full',
    ]}
    {...bookAttrs}
  >
    <slot />
    <svg
      class="h-3.5 w-3.5 transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-quint)] group-hover:translate-x-1"
      viewBox="0 0 14 14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>

  {note && <span class="text-meta max-w-[42ch] text-text-muted">{note}</span>}

  {
    reversal && (
      <span class="text-meta flex max-w-[42ch] items-start gap-2 text-text-muted">
        <span aria-hidden="true" class="text-accent">
          ✓
        </span>
        {reversal}
      </span>
    )
  }
</span>
