---
import { isPlaceholder } from '../lib/placeholder';
/**
 * No testimonial ships without a resolvable public profile URL — the link is the
 * trust mechanism and the quote is only the design. An unlinkable quote at this
 * density actively signals that nothing on the page is checkable.
 *
 * The attribution discloses the agency relationship. Implying he was the brand's
 * direct vendor would be the misrepresentation, and a material connection a
 * reader would want to know about has to be disclosed.
 */
interface Props {
  quote: string;
  name: string;
  title: string;
  company: string;
  profileUrl: string;
  relationship: string;
}

const { quote, name, title, company, profileUrl, relationship } = Astro.props;
const linkable = !isPlaceholder(profileUrl);
---

<figure class="max-w-[34ch]">
  {/* A quote is prose, so it stays in the serif Text face rather than stepping
      up to the Display face — the trinity split does not bend for emphasis. */}
  <blockquote class="text-body-lead text-on-dark">
    <p>“{quote}”</p>
  </blockquote>

  <figcaption class="mt-6 flex flex-col gap-1">
    <span class="label text-on-dark">
      {
        linkable ? (
          <a href={profileUrl} rel="noopener">
            {name}
          </a>
        ) : (
          name
        )
      }
    </span>
    <span class="label text-muted">{title}, {company}</span>
    <span class="text-body-sm mt-2 max-w-[38ch] text-muted">{relationship}</span>
    {
      !linkable && (
        <span class="text-body-sm mt-1 text-on-dark">
          Needs a public profile link before launch — see CONTENT.md.
        </span>
      )
    }
  </figcaption>
</figure>
