---
import { contact, identity } from '../data/site';

/**
 * Web3Forms was chosen over Formspree/Netlify/Tally for one reason that matters
 * here: it adds zero third-party JavaScript and sets zero cookies, which is
 * what lets the page hold its performance budget and truthfully say it needs no
 * consent banner. It also degrades properly — this is a real <form> with a real
 * action and a redirect field, so it submits with JavaScript disabled.
 *
 * Five fields, no more. The required budget select is deliberate: it filters
 * unqualified enquiries before they reach the inbox, and bot payloads routinely
 * omit selects.
 */
const mailtoBody = [
  'Store URL:',
  'Timeline:',
  'Budget:',
  'What we need:',
].join('\n');

const mailto = `mailto:${identity.email}?subject=${encodeURIComponent('Shopify project enquiry')}&body=${encodeURIComponent(mailtoBody)}`;
---

<div class="grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
  <form
    data-inquiry
    data-email={identity.email}
    action="https://api.web3forms.com/submit"
    method="POST"
    novalidate
    class="grid gap-5"
  >
    <input type="hidden" name="access_key" value={contact.web3formsKey} />
    <input type="hidden" name="subject" value={`New project enquiry — ${identity.origin}`} />
    <input type="hidden" name="from_name" value={identity.origin} />
    <input type="hidden" name="redirect" value={`${identity.origin}/thanks/`} />

    <!-- Honeypot. Web3Forms discards the submission if this is filled. -->
    <input
      type="checkbox"
      name="botcheck"
      tabindex="-1"
      aria-hidden="true"
      autocomplete="off"
      class="absolute -left-[9999px]"
    />

    <div class="grid gap-2">
      <label for="name" class="label text-text-muted">Your name</label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
        class="min-h-12 rounded-lg border border-line-strong bg-paper-raised px-4 py-3 text-body"
      />
    </div>

    <div class="grid gap-2">
      <label for="email" class="label text-text-muted">Work email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        aria-describedby="email-hint"
        class="min-h-12 rounded-lg border border-line-strong bg-paper-raised px-4 py-3 text-body"
      />
      <p id="email-hint" class="text-meta text-text-muted">
        I reply to every serious enquiry within one business day.
      </p>
    </div>

    <div class="grid gap-2">
      <label for="store" class="label text-text-muted">
        Store URL <span class="normal-case tracking-normal">(optional)</span>
      </label>
      <input
        id="store"
        name="store"
        type="url"
        inputmode="url"
        placeholder="https://"
        class="min-h-12 rounded-lg border border-line-strong bg-paper-raised px-4 py-3 text-body"
      />
    </div>

    <div class="grid gap-2">
      <label for="budget" class="label text-text-muted">Budget range</label>
      <select
        id="budget"
        name="budget"
        required
        class="min-h-12 rounded-lg border border-line-strong bg-paper-raised px-4 py-3 text-body"
      >
        <option value="">Select…</option>
        <option>Under $10k</option>
        <option>$10k–$25k</option>
        <option>$25k–$75k</option>
        <option>$75k+</option>
        <option>Not sure yet</option>
      </select>
    </div>

    <div class="grid gap-2">
      <label for="message" class="label text-text-muted">What are you trying to ship?</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        class="rounded-lg border border-line-strong bg-paper-raised px-4 py-3 text-body"></textarea>
    </div>

    <button
      type="submit"
      class="min-h-12 justify-self-start rounded-full bg-ink px-7 py-4 font-medium text-text-inverse transition-colors duration-[var(--duration-base)] hover:bg-accent"
    >
      Send project enquiry
    </button>

    <p data-form-status role="status" aria-live="polite" class="text-meta text-text-muted"></p>
  </form>

  <div
    data-form-success
    hidden
    tabindex="-1"
    class="rounded-xl border border-line bg-paper-raised p-6"
  >
    <p class="font-display text-title">Got it.</p>
    <p class="mt-3 text-body text-text-muted">
      I’ll reply within one business day. If it’s urgent, book a slot directly —
      that’s usually faster than email.
    </p>
  </div>

  <aside class="grid content-start gap-6 text-body">
    <div>
      <p class="label text-text-muted">Prefer email?</p>
      <p class="mt-2 flex flex-wrap items-center gap-3">
        <a href={mailto} class="underline decoration-line-strong underline-offset-4 hover:decoration-accent">
          {identity.email}
        </a>
        <button
          type="button"
          data-copy={identity.email}
          class="label min-h-8 rounded-full border border-line-strong px-3 py-1.5 text-text-muted transition-colors hover:border-ink hover:text-text"
          aria-label="Copy email address"
        >
          Copy
        </button>
        <span data-copy-status role="status" aria-live="polite" class="text-meta text-text-muted"></span>
      </p>
      <p class="text-meta mt-2 text-text-muted">
        The email link arrives pre-filled with the four things I need to answer properly.
      </p>
    </div>

    <div class="border-t border-line pt-6">
      <p class="label text-text-muted">What happens next</p>
      <ol class="mt-3 grid gap-2 text-body text-text-muted">
        <li>1 — I read it and reply within one business day.</li>
        <li>2 — If it looks like a fit, we take a 20-minute call.</li>
        <li>3 — You get a written scope with a price and a date.</li>
      </ol>
    </div>
  </aside>
</div>
