---
/**
 * The site's one ownable motif: a before/after diff.
 *
 * The − and + are real text, not pseudo-element decoration, so the meaning
 * survives copy/paste, screen readers announce it, and the state is never
 * carried by colour alone (WCAG 1.4.1). It repeats on work-card attribution,
 * case-study decisions, the 404 and the footer's own performance numbers —
 * which is what makes it a motif rather than an ornament.
 */
interface Props {
  minus: string;
  plus: string;
  class?: string;
}

const { minus, plus, class: className = '' } = Astro.props;

// Copy sometimes arrives with the glyph already in it (footer perf lines).
const strip = (s: string) => s.replace(/^[−+-]\s*/, '');
---

<div class:list={['diff', className]}>
  <p class="diff__minus">
    <span aria-hidden="true">−</span>
    <span><span class="sr-only">Before: </span>{strip(minus)}</span>
  </p>
  <p class="diff__plus">
    <span aria-hidden="true">+</span>
    <span><span class="sr-only">After: </span>{strip(plus)}</span>
  </p>
</div>
