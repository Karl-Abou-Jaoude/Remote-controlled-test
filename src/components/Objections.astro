---
import { objections } from '../data/site';
import SectionHead from './SectionHead.astro';

/**
 * ONE objection module, not four overlapping ones.
 *
 * The ANSWER is the visible heading and the fear is secondary. Leading with a
 * wall of fears in large type on a black band manufactures the anxiety it claims
 * to discharge for the majority of readers who never framed hiring one engineer
 * as risky. Only the three fears that are structurally universal to buying from
 * one person live here; the rest are opt-in via the FAQ.
 *
 * The process artifacts sit inside these answers as the evidence they already
 * are, rather than as a separate section repeating the same three claims.
 *
 * Nothing here animates: this is the densest body copy on the page at the
 * highest-anxiety moment. The words render instantly. Hairline rules top and
 * bottom are the only thing separating the section from its neighbours.
 */
---

<section
  id="objections"
  aria-labelledby="objections-heading"
  class="border-y border-hairline py-20 md:py-30"
>
  <div class="container-page">
    <SectionHead index="07" id="objections-heading">
      Hiring one person instead of an agency
    </SectionHead>

    <div class="mt-14 grid gap-12 md:gap-14">
      {
        objections.map((item) => (
          <div class="grid gap-5 border-t border-hairline pt-8 md:grid-cols-12 md:gap-10">
            <h3 class="display text-title-md md:col-span-5 md:max-w-[24ch]">{item.answer}</h3>

            <div class="md:col-span-7">
              <p class="text-body-sm text-muted">{item.fear}</p>
              <p class="text-body-md mt-4 max-w-[52ch] text-on-dark">{item.detail}</p>
              <div class="label mt-5 flex flex-wrap items-baseline gap-2 text-muted">
                <span class="text-on-dark">{item.artifact.label}</span>
                <span>{item.artifact.value}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
