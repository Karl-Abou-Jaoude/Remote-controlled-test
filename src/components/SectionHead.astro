---
/**
 * Section number + heading, in one place so every section aligns identically.
 *
 * The number is mono metadata, not an accent: with no chroma in the system it
 * sits in muted grey and lets the headline carry the section on its own.
 */
interface Props {
  index: string;
  id: string;
  class?: string;
}

const { index, id, class: className = '' } = Astro.props;
---

<div class:list={['flex items-baseline gap-4 md:gap-5', className]}>
  <span class="label shrink-0 text-muted" aria-hidden="true">{index}</span>
  <h2 id={id} class="display text-display-lg max-w-[30ch] uppercase text-on-dark">
    <slot />
  </h2>
</div>
