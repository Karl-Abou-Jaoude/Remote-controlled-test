---
/**
 * Section number + heading, in one place so every section aligns identically.
 *
 * The number stays muted: it is orientation, not emphasis, and the uppercase
 * display head beside it is already the loudest thing in the band.
 */
interface Props {
  index: string;
  id: string;
  class?: string;
}

const { index, id, class: className = '' } = Astro.props;
---

<div class:list={['flex items-baseline gap-4 md:gap-5', className]}>
  <span class="label shrink-0 text-text-muted" aria-hidden="true">{index}</span>
  <h2 id={id} class="display text-display max-w-[30ch]">
    <slot />
  </h2>
</div>
