---
import { identity, contact, footer, availability } from '../data/site';
import { isPlaceholder } from '../lib/placeholder';
import Cta from './Cta.astro';
import Diff from './Diff.astro';

const mailtoBody = ['Brand:', 'Timeline:', 'Budget range:', 'What we need:'].join('\n');
const mailto = `mailto:${identity.email}?subject=${encodeURIComponent('Shopify project enquiry')}&body=${encodeURIComponent(mailtoBody)}`;
---

<!--
  The footer repeats the primary CTA rather than ending on a link list: a
  bottom-of-page CTA is mandatory on a long page, because the reader who got here
  is the most convinced reader on the site.

  The site's own performance numbers appear as the motif applied to itself — the
  most direct possible proof for someone selling store performance, and the one
  claim on the page a buyer can verify in ten seconds with a link.

  Email is a plain clickable address. Obfuscation mostly breaks screen readers and
  does not stop scrapers, which is a bad trade on a site selling credibility.
-->
<footer class="border-t border-hairline py-20 md:py-28">
  <div class="container-page">
    <div class="grid gap-10 border-b border-hairline pb-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h2 class="display text-display-lg max-w-[26ch] uppercase text-on-dark">
          {footer.ctaHeading}
        </h2>
        <div class="mt-8">
          <Cta kind="book" position="footer" variant="primary">Book a 20-min call</Cta>
        </div>
      </div>

      <div class="grid content-start gap-6 lg:col-span-5">
        <div>
          <p class="label text-muted">Direct</p>
          <p class="mt-2 flex flex-wrap items-center gap-3">
            <a href={mailto} class="text-body-md">{identity.email}</a>
            <button
              type="button"
              data-copy={identity.email}
              class="label min-h-8 rounded-full border border-hairline-ui px-3 py-1.5 text-muted transition-colors hover:border-on-dark hover:text-on-dark"
              aria-label="Copy email address"
            >
              Copy
            </button>
            <span data-copy-status role="status" aria-live="polite" class="label text-muted"></span>
          </p>
        </div>

        <p class="text-body-sm text-muted">{footer.promise}</p>
        <p class="label text-muted">
          {availability.concurrentEngagements} slots · earliest start {availability.nextStartLabel}
        </p>
      </div>
    </div>

    <div class="grid gap-10 py-12 lg:grid-cols-12">
      <nav class="lg:col-span-4" aria-label="Footer">
        <p class="label text-muted">Site</p>
        <ul class="mt-4 grid gap-2.5">
          <li><a href="#cases" class="text-body-md">Work</a></li>
          <li><a href="#engagements" class="text-body-md">Pricing</a></li>
          <li><a href="#faq" class="text-body-md">FAQ</a></li>
          <li><a href="/about/" class="text-body-md">About</a></li>
          <li><a href="/privacy/" class="text-body-md">Privacy</a></li>
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="label text-muted">Elsewhere</p>
        <ul class="mt-4 grid gap-2.5">
          {
            contact.socials.map((s) => (
              <li>
                <a href={s.url} rel="noopener" class="text-body-md flex min-h-12 items-center">
                  {s.label} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-4">
        <p class="label text-muted">This page</p>
        <Diff minus={footer.perf.minus} plus={footer.perf.plus} class="mt-4" />
        {
          !isPlaceholder(footer.perf.proofUrl) ? (
            <a href={footer.perf.proofUrl} rel="noopener" class="label mt-3 inline-block text-muted">
              Verify on PageSpeed →
            </a>
          ) : (
            <p class="label mt-3 text-muted">Add a dated PageSpeed link — see CONTENT.md</p>
          )
        }
        <p class="text-body-sm mt-4 text-muted">
          No cookies, no consent banner, no third-party scripts until you ask for the calendar.
        </p>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-8 text-muted-soft"
    >
      <p class="label">{footer.credit}</p>
      <p class="label">WCAG 2.2 AA · keyboard-complete · honours reduced-motion</p>
    </div>
  </div>
</footer>
